# Copy to .env for host-side runs. Compose sets its own values for the api container.

# Required, no default. One of: local | test | staging | production
ENVIRONMENT=local
DEBUG=true
PUBLIC_BASE_URL=http://localhost:8000

DATABASE_URL=postgresql+asyncpg://shortener:shortener@localhost:5432/shortener
REDIS_URL=redis://localhost:6379/0

KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_CLICKS_TOPIC=clicks

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_USER=analytics
CLICKHOUSE_PASSWORD=dev-only-insecure-clickhouse

# >=32 chars, and MUST be replaced before any non-local use.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-change-me-0000000000000000
IP_HASH_KEY=dev-only-insecure-change-me-1111111111111111

GEOIP_DATABASE_PATH=/data/GeoLite2-City.mmdb
